  genre: {
    isElectronicArticle: true,
    defaultValue: 'article',
    usage: 'M',
    label: 'Žánr',
    selector: 'genre',
    labelKey: 'genre',
    description: 'Bližší údaje o typu dokumentu',
    fields: {
      value: {
        usage: 'M',
